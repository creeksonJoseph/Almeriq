# Development Environment Configuration
# Copy this file to .env.dev and fill in the values
# .env.dev is gitignored — never commit real secrets

# Database connection URL (SQLite for local development/testing)
DATABASE_URL=sqlite+aiosqlite:///./almeriq_dev.db

# Resend API Key for sending waitlist confirmation emails
RESEND_API_KEY=re_123456789

# Domain name used in email footer links
DOMAIN=alimeriq.app

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Authentication & Security Settings
JWT_SECRET_KEY=generate_a_random_32_byte_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

COOKIE_NAME=auth_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Google OAuth Credentials (empty for dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Upstash Redis (optional - falls back to in-memory store if not set)
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Gemini founder analysis (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Sentry (backend error tracking)
SENTRY_DSN=your-sentry-dsn-here
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0