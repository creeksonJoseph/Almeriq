# Backend environment variables
# Copy this file to .env for local development:
#   cp .env.example .env
# Replace placeholders with your own values. Never commit .env or real credentials.

# Database
# Local development uses SQLite. Use a PostgreSQL URL in hosted environments.
DATABASE_URL=sqlite+aiosqlite:///./almeriq_dev.db

# Application domain and browser origins
DOMAIN=alimeriq.app
# Comma-separated list. Keep the frontend origins you actually use.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,https://alimeriq.app,https://www.alimeriq.app

# Authentication
# Generate a unique, random secret for each environment. Do not use this placeholder.
JWT_SECRET_KEY=replace_with_a_unique_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
COOKIE_NAME=auth_token
# false for local HTTP; set true when the deployed app uses HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Email (optional for local development)
RESEND_API_KEY=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI features (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Media uploads (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis (optional; the app has a fallback when it is not configured)
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Error monitoring (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
