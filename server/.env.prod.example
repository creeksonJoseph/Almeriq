# Production Environment Configuration
# This file is a template — NEVER commit real secrets
# The actual .env.prod is supplied by the user at deploy time and is gitignored

# Database connection URL (PostgreSQL/Neon for production)
# Neon requires sslmode=require; include it in the URL:
# postgresql+psycopg://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@hostname:5432/dbname?sslmode=require

# Resend API Key for sending waitlist confirmation emails
RESEND_API_KEY=re_123456789

# Domain name used in email footer links
DOMAIN=alimeriq.app

# Allowed CORS origins (comma-separated) — production domains only
ALLOWED_ORIGINS=https://alimeriq.app,https://www.alimeriq.app

# Authentication & Security Settings
JWT_SECRET_KEY=generate_a_random_32_byte_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

COOKIE_NAME=auth_token
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Upstash Redis (optional - falls back to in-memory store if not set)
UPSTASH_REDIS_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_TOKEN=your_upstash_redis_token_here

# Gemini founder analysis (server-side only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Sentry (backend error tracking) — production DSN
SENTRY_DSN=your-sentry-prod-dsn-here
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1